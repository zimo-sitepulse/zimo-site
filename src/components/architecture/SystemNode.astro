---
import ZimoMark from "./ZimoMark.astro";
import type { Position } from "./model";
interface Props {
  kind: "gateway" | "cloud" | "dashboard";
  position: Position;
}
const { kind, position } = Astro.props;
const cloudShape =
  "M-88 65C-118 65-140 44-140 15C-140-9-124-29-102-35C-102-55-87-70-67-70C-57-70-48-66-42-59C-34-75-18-85 0-85C18-85 34-75 42-59C48-66 57-70 67-70C87-70 102-55 102-35C124-29 140-9 140 15C140 44 118 65 88 65Z";
const delay = { gateway: 160, cloud: 1050, dashboard: 1450 }[kind];
---

<g transform={`translate(${position.x} ${position.y}) scale(${position.scale ?? 1})`}>
  <g class:list={["architecture-node", `system-${kind}`]} style={`--delay: ${delay}ms`}>
    {kind === "gateway" && (
      <>
        <path d="M26-53V-83a3 3 0 0 1 6 0v30" class="hardware-outline" />
        <rect x="-48" y="-52" width="96" height="110" rx="12" class="hardware-box" />
        <circle cx="36" cy="-39" r="3" class="accent-fill" />
        <ZimoMark />
        <text y="27" class="gateway-label">
          SitePulse
        </text>
        <text y="45" class="gateway-label">
          Gateway
        </text>
      </>
    )}
    {kind === "cloud" && (
      <>
        <path d={cloudShape} class="cloud-glow" />
        <path d={cloudShape} class="cloud-outline" />
        <!-- Center the combined logo and label within the cloud, including its upper dome. -->
        <g transform="translate(0 -15)">
          <ZimoMark />
          <text y="38" class="cloud-label">
            SitePulse Cloud
          </text>
        </g>
      </>
    )}
    {kind === "dashboard" && (
      <>
        <rect x="-120" y="-82" width="240" height="168" rx="10" class="hardware-box" />
        <rect x="-108" y="-69" width="216" height="142" rx="3" class="screen-fill" />
        <circle cx="-89" cy="-47" r="3" class="accent-fill" />
        <text x="-77" y="-42" class="screen-title">
          SitePulse
        </text>
        <path d="M-90 30H90M-90 5H90M-90-20H90" class="chart-grid" />
        <path
          d="M-89 25C-72 25-78 4-59 6S-35 21-19 4S3-7 16-3S30 4 43-14S64-7 72-5S83-3 90-3"
          class="chart-line"
        />
        <path d="M-88 51h40m18 0h35m20 0h62" class="screen-detail" />
        <path d="M-137 86H137V91Q131 100 109 100H-109Q-131 100-137 91Z" class="hardware-box" />
        <path d="M-28 86l5 5h46l5-5" class="hardware-outline" />
        <text y="128" class="dashboard-label">
          Oversikt og dokumentasjon
        </text>
      </>
    )}
  </g>
</g>
