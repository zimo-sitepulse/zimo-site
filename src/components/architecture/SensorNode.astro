---
import type { Position, sensors } from "./model";
interface Props {
  sensor: (typeof sensors)[number];
  position: Position;
  delay: number;
}
const { sensor, position, delay } = Astro.props;
---

<g transform={`translate(${position.x} ${position.y})`}>
  <g class="architecture-node" style={`--delay: ${delay}ms`}>
    <rect x="-27" y="-27" width="54" height="54" rx="12" class="node-box" />
    <path d={sensor.icon} transform="translate(-12 -12)" class="node-icon" />
    <circle cx="19" cy="-19" r="2.5" class="accent-fill" />
    <text y="49" class="sensor-label">
      {sensor.label}
    </text>
  </g>
</g>
