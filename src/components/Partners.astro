---
import { site } from "../data/site";

const partners = [{ name: "Veidekke", logo: "/partners/veidekke.svg", width: 4800, height: 1400 }];
---

<section class="bg-white py-14 text-[#111315] sm:py-16 lg:py-20" aria-labelledby="partners-heading">
  <div class="zimo-shell text-center">
    <p class="zimo-eyebrow text-[#786500]">Samarbeidspartnere</p>
    <h2
      id="partners-heading"
      class="mx-auto mt-4 max-w-3xl text-3xl font-semibold leading-tight tracking-[-0.035em] sm:text-4xl"
    >
      Bedre løsninger gjennom samarbeid.
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-[#566267] sm:text-lg">
      Vil du være en samarbeidspartner? Bli med på å utvikle bedre løsninger for byggeplassen.
    </p>
    <ul
      class="my-10 flex flex-wrap items-center justify-center gap-x-16 gap-y-8 sm:my-12"
      aria-label="Våre samarbeidspartnere"
    >
      {partners.map((partner) => (
        <li>
          <img
            src={partner.logo}
            alt={partner.name}
            width={partner.width}
            height={partner.height}
            class="h-auto w-52 max-w-full grayscale sm:w-60"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
    <a
      href={site.contact}
      class="inline-flex min-h-12 items-center justify-center gap-5 rounded-[8px] bg-brand px-6 py-3.5 text-sm font-semibold transition-colors hover:bg-brand-hover"
    >
      Bli samarbeidspartner <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
