---
import { site } from "../data/site";

const partners = [{ name: "Veidekke", logo: "/partners/veidekke.svg", width: 4800, height: 1400 }];
---

<section
  class="border-b border-[#D4D8D5] bg-[#F5F5F2] py-14 lg:py-20"
  aria-labelledby="partners-heading"
>
  <div class="zimo-shell">
    <h2 id="partners-heading" class="text-3xl font-semibold tracking-[-0.035em] sm:text-4xl">
      Samarbeidspartnere
    </h2>
    <div class="mt-8 grid items-center gap-8 sm:mt-10 lg:grid-cols-2 lg:gap-16">
      <ul class="flex flex-wrap items-center gap-10" aria-label="Våre samarbeidspartnere">
        {partners.map((partner) => (
          <li>
            <img
              src={partner.logo}
              alt={partner.name}
              width={partner.width}
              height={partner.height}
              class="h-auto w-56 max-w-full sm:w-64"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
      <div class="border-t border-[#D4D8D5] pt-6 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
        <h3 class="text-xl font-semibold tracking-[-0.02em] sm:text-2xl">
          Vil du være en samarbeidspartner?
        </h3>
        <a
          href={site.contact}
          class="mt-3 inline-flex min-h-11 items-center gap-4 font-semibold underline decoration-[#BFC6C3] underline-offset-4 transition-colors hover:text-[#68767A]"
        >
          Kontakt oss <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
