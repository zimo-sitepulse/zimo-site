---
import { site } from "../data/site";

const partners = [{ name: "Veidekke", logo: "/partners/veidekke.svg", width: 4800, height: 1400 }];
---

<section class="bg-[#111315] py-8 text-white sm:py-10" aria-labelledby="partners-heading">
  <div class="zimo-shell text-center">
    <h2 id="partners-heading" class="text-xs font-medium uppercase tracking-[0.14em] text-white/55">
      Samarbeidspartnere
    </h2>
    <ul
      class="my-6 flex flex-wrap items-center justify-center gap-x-16 gap-y-8"
      aria-label="Våre samarbeidspartnere"
    >
      {partners.map((partner) => (
        <li>
          <img
            src={partner.logo}
            alt={partner.name}
            width={partner.width}
            height={partner.height}
            class="h-auto w-48 max-w-full opacity-80 brightness-0 invert sm:w-52"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
    <a
      href={site.contact}
      class="inline-flex min-h-11 items-center justify-center gap-3 text-sm text-white/60 transition-colors hover:text-white"
    >
      Bli samarbeidspartner <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
