---
import { products, productHref } from "../data/products";

interface Props {
  mobile?: boolean;
}
const { mobile = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const activeProduct = products.find(
  (product) => productHref(product).replace(/\/$/, "") === currentPath,
);
---

<details class:list={["product-menu relative", { "px-3": mobile }]}>
  <summary
    class:list={[
      "flex cursor-pointer list-none items-center gap-2 rounded-sm font-medium transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4",
      mobile ? "py-3" : "min-h-10 border-b-2 py-2",
      activeProduct
        ? "border-brand text-brand"
        : "border-transparent text-white/70 hover:text-white",
      { "underline decoration-brand decoration-2 underline-offset-8": mobile && activeProduct },
    ]}
  >
    Produkter
    <svg
      class="product-chevron h-4 w-4 transition-transform"
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="m5 7.5 5 5 5-5" />
    </svg>
  </summary>
  <ul
    class:list={[
      "grid gap-1 rounded-md border border-[#d9dde0] bg-white p-2 text-sm text-[#20272a]",
      mobile ? "mb-2" : "absolute left-0 top-full z-10 w-80 shadow-lg",
    ]}
  >
    {products.map((product) => (
      <li>
        <a
          href={productHref(product)}
          aria-current={product === activeProduct ? "page" : undefined}
          class:list={[
            "flex flex-wrap items-center gap-2 rounded-sm border-l-2 px-3 py-3 font-medium transition-colors hover:bg-[#fff8cc]",
            product === activeProduct ? "border-brand bg-[#fff8cc]" : "border-transparent",
          ]}
        >
          <span>{product.label}</span>
          {product.comingSoon && (
            <span class="rounded-full bg-[#fff8cc] px-2 py-1 text-[10px] font-semibold text-[#584613]">
              Kommer snart
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
</details>
<style>
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] .product-chevron {
    transform: rotate(180deg);
  }
</style>
