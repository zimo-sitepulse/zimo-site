---
const { mobile = false } = Astro.props;
const products = [
  { label: "Temp/luftfuktighet", href: "/sitepulse/#temperatur-luftfuktighet" },
  { label: "Strømstøpsel", href: "/sitepulse/#stromstopsel" },
  { label: "Gateway", href: "/sitepulse/#gateway" },
  { label: "Fuktighetsmåler i betong" },
  { label: "Fuktighetsmåler i tre" },
];
---
<details class:list={["product-menu relative text-white", { "px-3": mobile }]}>
  <summary class:list={["flex cursor-pointer list-none items-center gap-2 rounded-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-4", mobile ? "py-3" : "py-2"]}>
    Produkter
    <svg class="product-chevron h-4 w-4 transition-transform" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
  </summary>
  <ul class:list={["grid gap-1 rounded-md border border-[#d9dde0] bg-white p-2 text-sm text-[#20272a]", mobile ? "mb-2" : "absolute left-0 top-full z-10 w-80 shadow-lg"]}>
    {products.map((product) => <li>{product.href ? <a href={product.href} class="block rounded-sm px-3 py-3 font-medium transition-colors hover:bg-[#fff8cc]">{product.label}</a> : <span class="flex flex-wrap items-center gap-2 px-3 py-3 text-[#657276]"><span>{product.label}</span><span class="rounded-full bg-[#fff8cc] px-2 py-1 text-[10px] font-semibold text-[#584613]">Kommer snart</span></span>}</li>)}
  </ul>
</details>
<style>
  summary::-webkit-details-marker { display: none; }
  details[open] .product-chevron { transform: rotate(180deg); }
</style>
<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>(".product-menu");
  menus.forEach((menu) => {
    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) menu.open = false;
    });
  });
  document.addEventListener("click", (event) => {
    menus.forEach((menu) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") menus.forEach((menu) => {
      if (menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  });
</script>
