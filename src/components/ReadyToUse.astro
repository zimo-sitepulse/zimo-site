---
import { readyToUse } from "../data/site";
---

<section
  class="border-b border-[#D4D8D5] bg-white py-14 lg:py-20"
  aria-labelledby="ready-to-use-heading"
>
  <div class="zimo-shell grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-16">
    <div>
      <p class="zimo-eyebrow text-[#786500]">Plug & play</p>
      <h2
        id="ready-to-use-heading"
        class="mt-4 max-w-xl text-3xl font-semibold leading-[1.12] tracking-[-0.035em] sm:text-4xl"
      >
        {readyToUse.title}
      </h2>
    </div>
    <div>
      <p class="max-w-xl text-lg leading-relaxed text-[#566267]">{readyToUse.description}</p>
      <p class="mt-5 text-base font-semibold">Vi tar oppsettet. Dere tar det i bruk.</p>
    </div>
  </div>
</section>
