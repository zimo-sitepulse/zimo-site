---
import ProductMenu from "./ProductMenu.astro";
import NavLink from "./NavLink.astro";
import { site } from "../data/site";
---

<header data-site-header class="sticky top-0 z-50 border-b border-white/10 bg-[#111315] text-white">
  <div class="zimo-shell flex h-[4.75rem] items-center justify-between">
    <a href={site.home} class="flex min-h-11 items-center" aria-label="ZiMO hjem">
      <img
        src="/brand/ZiMO_full_white.svg"
        alt="ZiMO"
        class="h-9 w-auto"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav
      class="hidden items-center gap-5 text-[13px] font-medium text-white/62 lg:flex"
      aria-label="Hovednavigasjon"
    >
      <NavLink href={site.home}>Hovedside</NavLink>
      <ProductMenu />
      <NavLink href={site.pricing}>Prisoversikt</NavLink>
      <NavLink href={site.breeam}>BREEAM-NOR</NavLink>
      <NavLink href={site.contact}>Kontakt oss</NavLink>
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a
        href={site.cloud}
        target="_blank"
        rel="noreferrer"
        class="cursor-pointer text-[13px] font-medium text-white/62 transition-colors duration-200 hover:text-white"
      >
        Åpne Cloud
      </a>
      <a
        href={site.becomeCustomer}
        class="inline-flex min-h-10 cursor-pointer items-center justify-center rounded-[8px] bg-brand px-4 py-2.5 text-[13px] font-semibold text-[#111315] transition-colors duration-200 hover:bg-brand-hover"
      >
        Bli kunde
      </a>
    </div>

    <button
      class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-[8px] border border-white/20 text-white transition-colors duration-200 hover:border-white/45 hover:bg-white/10 lg:hidden"
      type="button"
      aria-label="Åpne meny"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-toggle
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16" />
        <path d="M4 12h16" />
        <path d="M4 17h16" />
      </svg>
    </button>
  </div>

  <div
    class="zimo-shell hidden border-t border-white/10 pb-4 pt-3 lg:hidden"
    id="mobile-menu"
    data-mobile-menu
  >
    <nav
      class="grid border border-white/10 bg-[#1B1F23] p-2 text-sm text-white"
      aria-label="Mobilnavigasjon"
    >
      <NavLink href={site.home} mobile>
        Hovedside
      </NavLink>
      <ProductMenu mobile />
      <NavLink href={site.pricing} mobile>
        Prisoversikt
      </NavLink>
      <NavLink href={site.breeam} mobile>
        BREEAM-NOR
      </NavLink>
      <NavLink href={site.contact} mobile>
        Kontakt oss
      </NavLink>
      <a
        href={site.cloud}
        target="_blank"
        rel="noreferrer"
        class="rounded-[7px] px-3 py-3 font-medium text-brand transition-colors duration-200 hover:bg-white/10"
      >
        Åpne Cloud
      </a>
      <a
        href={site.becomeCustomer}
        class="rounded-[7px] bg-brand px-3 py-3 font-semibold text-[#111315]"
      >
        Bli kunde
      </a>
    </nav>
  </div>

  <script>
    import "../scripts/navigation";
  </script>
</header>
