---
import { site } from "../data/site";
import SitePulseArchitecture from "./SitePulseArchitecture.astro";
---

<section class="sitepulse-hero bg-[#111315] text-white" aria-labelledby="hero-title">
  <div class="zimo-shell hero-grid">
    <div class="hero-copy">
      <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.16em] text-white/65">
        <span class="h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>SitePulse fra ZiMO
      </p>
      <h1 id="hero-title">
        Data som gir oversikt.{" "}
        <span class="block">
          Oversikt som <span class="text-brand">lønner seg.</span>
        </span>
      </h1>
      <p class="hero-description text-white/70">
        Samle data, optimaliser energibruken og styr byggeplassen aktivt. Dokumentasjonen samles
        automatisk.
      </p>
      <div class="hero-actions flex flex-wrap gap-3">
        <a
          href={site.becomeCustomer}
          class="inline-flex min-h-12 items-center justify-center gap-6 rounded-[8px] bg-brand px-5 py-3 text-sm font-semibold text-[#111315] transition-colors hover:bg-brand-hover"
        >
          Bli kunde <span aria-hidden="true">↗</span>
        </a>
        <a
          href="#slik-fungerer-det"
          class="inline-flex min-h-12 items-center justify-center rounded-[8px] border border-white/30 px-5 py-3 text-sm font-medium transition-colors hover:bg-white/10"
        >
          Slik fungerer det
        </a>
      </div>
    </div>
    <SitePulseArchitecture />
  </div>
</section>

<style>
  .sitepulse-hero {
    padding-block: clamp(1.5rem, 5svh, 4rem);
  }
  .hero-grid {
    display: grid;
    align-items: center;
    gap: 1.5rem;
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2rem, 4.2vw, 3.75rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.05em;
  }
  .hero-description {
    margin-top: 1.25rem;
    max-width: 30rem;
    font-size: 1rem;
    line-height: 1.6;
  }
  .hero-actions {
    margin-top: 1.5rem;
  }
  @media (max-width: 767px) {
    .sitepulse-hero {
      padding-block: 1.25rem;
    }
    .hero-grid {
      gap: 1rem;
    }
    .hero-description {
      font-size: 0.9375rem;
    }
  }
  @media (min-width: 1024px) {
    .sitepulse-hero {
      min-height: calc(100svh - 4.8125rem);
      display: grid;
      align-items: center;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(1.5rem, 3vw, 3rem);
    }
    h1 {
      margin-top: 1.5rem;
    }
    .hero-description {
      font-size: 1.125rem;
    }
    .hero-actions {
      margin-top: 2rem;
    }
  }
</style>
