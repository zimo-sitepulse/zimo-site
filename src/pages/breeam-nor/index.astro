---
import Layout from "../../layouts/Layout.astro";
import { site, contactHref } from "../../data/site";

const sources = {
  energy:
    "https://breeam-nor.byggalliansen.no/v6/kategorier-og-emner/1-ledelse/man-03-ansvarlig-byggepraksis/reduksjon-av-klimagassutslipp-fra-aktiviteter-tilknyttet-utbyggingsomradet/",
  moisture:
    "https://breeam-nor.byggalliansen.no/v6/kategorier-og-emner/materialer/mat-05-robust-og-klimatilpasset-konstruksjon/fuktsikkerhet-i-byggefasen/",
  standards:
    "https://standard.no/fagomrader/ns-3511-og-ns-3512---nye-standarder-for-maling-av-fukt-i-betong-og-trekonstruksjoner/",
};
---

<Layout
  title="BREEAM-NOR-dokumentasjon – SitePulse fra ZiMO"
  description="En oversikt over hvordan SitePulse støtter energidokumentasjon under Man 03 og fuktsikkerhet under Mat 05, med kommende sensorer for NS 3511 og NS 3512."
>
  <section class="bg-[#111315] py-12 text-white sm:py-16">
    <div class="zimo-shell">
      <p class="zimo-eyebrow text-brand">BREEAM-NOR</p>
      <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-[1.1] tracking-[-0.035em] sm:text-5xl">
        Dokumentasjon for
        <br />
        energi og fukt.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/75">
        SitePulse samler måledata og historikk til prosjektets dokumentasjonsarbeid. Her er de to
        områdene vi kan bidra på.
      </p>
      <nav class="mt-8 grid max-w-3xl gap-4 sm:grid-cols-2" aria-label="Velg dokumentasjonsområde">
        <a
          href="#man-03"
          class="group rounded-[8px] border border-white/25 p-5 transition-colors hover:border-brand hover:bg-white/5"
        >
          <span class="text-xs font-semibold text-brand">MAN 03</span>
          <span class="mt-2 flex items-center justify-between text-xl font-semibold">
            Energibruk <span aria-hidden="true">↓</span>
          </span>
          <span class="mt-2 block text-sm text-white/70">
            Målt forbruk og oppfølging av energitiltak.
          </span>
        </a>
        <a
          href="#mat-05"
          class="group rounded-[8px] border border-white/25 p-5 transition-colors hover:border-brand hover:bg-white/5"
        >
          <span class="text-xs font-semibold text-brand">MAT 05</span>
          <span class="mt-2 flex items-center justify-between text-xl font-semibold">
            Fuktsikkerhet <span aria-hidden="true">↓</span>
          </span>
          <span class="mt-2 block text-sm text-white/70">
            Klimahistorikk og kommende materialmålinger.
          </span>
        </a>
      </nav>
    </div>
  </section>

  <div class="zimo-shell space-y-6 py-10 sm:py-14">
    <section id="man-03" class="rounded-[8px] border border-[#D4D8D5] bg-white p-6 sm:p-8 lg:p-10">
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-md bg-[#111315] px-3 py-1.5 text-sm font-semibold text-white">
          Man 03
        </span>
        <h2 class="text-2xl font-semibold tracking-[-0.025em] sm:text-3xl">Energibruk</h2>
      </div>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#566267]">
        Følg energibruken gjennom byggefasen og bruk målingene til å vurdere energitiltak.
      </p>
      <div class="mt-7 grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <h3 class="font-semibold">Dette bidrar SitePulse med</h3>
          <ul class="mt-4 list-disc space-y-3 pl-5 text-base leading-relaxed text-[#566267] marker:text-[#8B7500]">
            <li>Måledata fra tilkoblet energimåleutstyr.</li>
            <li>Historikk for å følge forbruk og justere driften.</li>
            <li>Datagrunnlag til energidokumentasjon og videre klimagassberegninger.</li>
          </ul>
        </div>
        <div class="rounded-[8px] bg-[#F5F5F2] p-5 sm:p-6">
          <h3 class="font-semibold">Dette avklarer vi med dere</h3>
          <p class="mt-3 text-base leading-relaxed text-[#566267]">
            Hvilket utstyr, hvilke aktiviteter og hvilke perioder som skal måles.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-[#566267]">
            Prosjektets underlag må også omfatte relevante energibærere som brensel,
            klimagassberegninger og sammenligning med planen.
          </p>
        </div>
      </div>
    </section>

    <section id="mat-05" class="rounded-[8px] border border-[#D4D8D5] bg-white p-6 sm:p-8 lg:p-10">
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-md bg-[#111315] px-3 py-1.5 text-sm font-semibold text-white">
          Mat 05
        </span>
        <h2 class="text-2xl font-semibold tracking-[-0.025em] sm:text-3xl">Fuktsikkerhet</h2>
      </div>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#566267]">
        Samle historikken som støtter oppfølging av uttørking og fuktforhold.
      </p>
      <div class="mt-7 grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <h3 class="font-semibold">Dette tilbyr vi nå</h3>
          <ul class="mt-4 list-disc space-y-3 pl-5 text-base leading-relaxed text-[#566267] marker:text-[#8B7500]">
            <li>Løpende måling av temperatur og luftfuktighet.</li>
            <li>Klimahistorikk fra byggeplassen under uttørking.</li>
            <li>Underlag som kan støtte prosjektets fuktdokumentasjon.</li>
          </ul>
          <a
            href="/produkter/temperatur-luftfuktighet/"
            class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold underline underline-offset-4 transition-colors hover:text-[#68767A]"
          >
            Se temperatur- og luftfuktighetssensoren →
          </a>
        </div>
        <div class="rounded-[8px] bg-[#F5F5F2] p-5 sm:p-6">
          <h3 class="font-semibold">Klima og materialfukt</h3>
          <p class="mt-3 text-base leading-relaxed text-[#566267]">
            Temperatur og luftfuktighet beskriver klimaet. Fukt i betong og tre må måles i selve
            materialet.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-[#566267]">
            Prosjektet trenger også kontrollplan, sjekklister og dokumentasjon av uttørking og
            relevante fuktnivåer.
          </p>
        </div>
      </div>
      <div class="mt-8 border-t border-[#D4D8D5] pt-7">
        <div class="flex flex-wrap items-center gap-3">
          <h3 class="text-lg font-semibold">Sensorer for materialfukt</h3>
          <span class="rounded-full bg-brand px-3 py-1 text-xs font-semibold">Kommer snart</span>
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <a
            href="/produkter/fuktighetsmaler-betong/"
            class="rounded-[8px] border border-[#D4D8D5] p-5 transition-colors hover:bg-[#fff8cc]"
          >
            <span class="block font-semibold">
              Betong · NS 3511 <span aria-hidden="true">→</span>
            </span>
            <span class="mt-2 block text-sm leading-relaxed text-[#566267]">
              Utvikles for måling av relativ fuktighet i borehull før overflatebelegg.
            </span>
          </a>
          <a
            href="/produkter/fuktighetsmaler-tre/"
            class="rounded-[8px] border border-[#D4D8D5] p-5 transition-colors hover:bg-[#fff8cc]"
          >
            <span class="block font-semibold">
              Tre · NS 3512 <span aria-hidden="true">→</span>
            </span>
            <span class="mt-2 block text-sm leading-relaxed text-[#566267]">
              Utvikles for måling av fukt i trekonstruksjoner før innbygging.
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="px-1 py-5 sm:px-2" aria-labelledby="rammer">
      <h2 id="rammer" class="text-lg font-semibold">
        En del av prosjektets dokumentasjon
      </h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-[#566267]">
        SitePulse støtter dokumentasjonsarbeidet. Prosjektet og BREEAM-revisoren vurderer samlet
        kravoppfyllelse; systemet gir ikke automatisk poeng eller sertifisering.
      </p>
      <details class="mt-5 max-w-3xl rounded-[8px] border border-[#D4D8D5] bg-white p-5">
        <summary class="cursor-pointer font-medium focus-visible:outline-2 focus-visible:outline-offset-4">
          Manualversjon og faglige kilder
        </summary>
        <p class="mt-4 text-sm leading-relaxed text-[#566267]">
          Omtalen bygger på BREEAM-NOR v6.1.1. Måleoppsett og underlag tilpasses manualversjonen og
          kontrollplanen i prosjektet.
        </p>
        <ul class="mt-3 space-y-1 text-sm">
          <li>
            <a
              href={sources.energy}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-[#68767A]"
            >
              Man 03 – Grønn Byggallianse ↗
            </a>
          </li>
          <li>
            <a
              href={sources.moisture}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-[#68767A]"
            >
              Mat 05 – Grønn Byggallianse ↗
            </a>
          </li>
          <li>
            <a
              href={sources.standards}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-[#68767A]"
            >
              NS 3511 og NS 3512 – Standard Norge ↗
            </a>
          </li>
        </ul>
      </details>
    </section>
  </div>

  <section class="bg-brand py-12 sm:py-16">
    <div class="zimo-shell flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center">
      <div>
        <h2 class="text-2xl font-semibold tracking-[-0.025em] sm:text-3xl">
          Hva trenger dere å dokumentere?
        </h2>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-[#443B0C]">
          Vi hjelper dere å avklare målinger, utstyr og underlag for prosjektet.
        </p>
      </div>
      <div class="shrink-0">
        <a
          href={contactHref("BREEAM-NOR – dokumentasjon med SitePulse")}
          class="inline-flex min-h-12 items-center justify-center rounded-[8px] bg-[#111315] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#30373A]"
        >
          Snakk med oss om prosjektet
        </a>
        <a href={site.contact} class="mt-4 block text-sm underline underline-offset-4">
          Se kontaktinformasjon →
        </a>
      </div>
    </div>
  </section>
</Layout>
