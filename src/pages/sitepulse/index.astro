---
import { site } from "../../data/site";
import Layout from "../../layouts/Layout.astro";
import SitePulseArchitecture from "../../components/SitePulseArchitecture.astro";
import Partners from "../../components/Partners.astro";

const benefits = [
  {
    number: "01",
    title: "Energioptimalisering",
    text: "La målingene styre byggvarme og tilkoblet utstyr etter faktisk behov. Følg utviklingen og juster driften for å begrense unødvendig energibruk.",
  },
  {
    number: "02",
    title: "Aktiv byggeplasskontroll",
    text: "Koble oversikt til handling. Følg forholdene, få varsler ved avvik og la avtalte regler styre utstyret, slik at teamet kan gripe inn når det trengs.",
  },
  {
    number: "03",
    title: "Leverandøruavhengighet",
    text: "Samle kompatibelt utstyr fra ulike leverandører i én løsning. Velg utstyr etter prosjektets behov; vi avklarer hvilke enheter og funksjoner som kan kobles til.",
  },
  {
    number: "04",
    title: "Bedre prosjektøkonomi",
    text: "Reduser energisløsing og tid brukt på manuell oppfølging. Bygg videre på utstyret dere har, og tilpass oppsettet til det prosjektet faktisk trenger.",
  },
];
---

<Layout
  title="SitePulse fra ZiMO – energioptimalisering og aktiv byggeplasskontroll"
  description="Energioptimalisering, aktiv byggeplasskontroll og leverandøruavhengighet. SitePulse gir bedre grunnlag for styring og økonomi på byggeplassen."
>
  <section class="overflow-hidden bg-[#111315] pb-16 pt-16 text-white sm:pt-24 lg:pb-20 lg:pt-28">
    <div class="zimo-shell">
      <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.16em] text-white/65">
        <span class="h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>SitePulse fra ZiMO
      </p>
      <h1 class="mt-8 max-w-5xl text-[clamp(2.6rem,6.5vw,6rem)] font-semibold leading-[1.04] tracking-[-0.05em]">
        Data som gir oversikt.
        <br />
        Oversikt som <span class="text-brand">lønner seg.</span>
      </h1>
      <div class="mt-8 space-y-7">
        <p class="max-w-2xl text-lg leading-relaxed text-white/70 sm:text-xl">
          SitePulse kobler målinger til aktiv styring av byggeplassen. Optimaliser energibruken,
          følg opp avvik og samle kompatibelt utstyr fra ulike leverandører i én løsning. Bedre
          kontroll på drift og økonomi, med dokumentasjonen samlet underveis.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={site.becomeCustomer}
            class="inline-flex min-h-12 items-center justify-center gap-8 rounded-[8px] bg-brand px-6 py-3.5 text-sm font-semibold text-[#111315] transition-colors hover:bg-brand-hover"
          >
            Bli kunde <span aria-hidden="true">↗</span>
          </a>
          <a
            href="#slik-fungerer-det"
            class="inline-flex min-h-12 items-center justify-center rounded-[8px] border border-white/30 px-6 py-3.5 text-sm font-medium transition-colors hover:bg-white/10"
          >
            Se hvordan det fungerer
          </a>
        </div>
      </div>
      <SitePulseArchitecture />
      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-white/15 pt-6 text-xs font-medium text-white/60">
        <span>Energioptimalisering</span>
        <span>Aktiv byggeplasskontroll</span>
        <span>Leverandøruavhengighet</span>
        <span>Prosjektøkonomi</span>
      </div>
    </div>
  </section>

  <section
    class="border-b border-[#D4D8D5] bg-[#F5F5F2] py-16 lg:py-24"
    aria-label="Hva SitePulse gjør for dere"
  >
    <div class="zimo-shell grid gap-12 md:grid-cols-2 md:gap-x-16">
      {benefits.map((item) => (
        <article>
          <p class="text-xs font-semibold text-[#68767A]">{item.number}</p>
          <h2 class="mt-5 text-2xl font-semibold tracking-[-0.03em] lg:text-3xl">{item.title}</h2>
          <p class="mt-4 max-w-md text-base leading-relaxed text-[#566267]">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="slik-fungerer-det" class="bg-[#1B1F23] py-16 text-white lg:py-24">
    <div class="zimo-shell">
      <div class="mb-12 grid gap-8 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="zimo-eyebrow text-brand">Fra byggeplassen til beslutningen</p>
          <h2 class="mt-5 max-w-xl text-4xl font-semibold leading-[1.08] tracking-[-0.04em] sm:text-5xl">
            Fra måling
            <br />
            til aktiv styring.
          </h2>
        </div>
        <p class="max-w-lg text-lg leading-relaxed text-white/70 lg:justify-self-end">
          SitePulse gir dere grunnlag for å styre byggeplassen etter det som faktisk skjer.
          Målinger, varsler og regler henger sammen, og historikken gjør det enklere å følge opp
          både driften og tiltakene dere setter i gang.
        </p>
      </div>
      <ol class="grid gap-8 md:grid-cols-3">
        <li class="border-t border-white/20 pt-5">
          <span class="text-xs text-brand">01 / Mål behovet</span>
          <h3 class="mt-3 text-xl font-semibold">Se hva byggeplassen trenger.</h3>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-white/65">
            Sensorer følger temperatur, luftfuktighet og status, slik at driften kan tilpasses
            forholdene på byggeplassen.
          </p>
        </li>
        <li class="border-t border-white/20 pt-5">
          <span class="text-xs text-brand">02 / Styr aktivt</span>
          <h3 class="mt-3 text-xl font-semibold">La målingene utløse handling.</h3>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-white/65">
            Bruk regler for byggvarme og tilkoblet utstyr. Varsler gjør teamet oppmerksom på avvik
            som må følges opp.
          </p>
        </li>
        <li class="border-t border-white/20 pt-5">
          <span class="text-xs text-brand">03 / Følg opp økonomien</span>
          <h3 class="mt-3 text-xl font-semibold">Juster driften underveis.</h3>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-white/65">
            Bruk historikken til å vurdere driften, prioritere tiltak og følge energibruken der den
            måles. Dokumentasjonen samles løpende.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="border-b border-[#D4D8D5] bg-white py-16 lg:py-20">
    <div class="zimo-shell grid gap-8 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="zimo-eyebrow">BREEAM-NOR</p>
        <h2 class="mt-5 max-w-xl text-3xl font-semibold leading-[1.12] tracking-[-0.035em] sm:text-4xl">
          Kontroll som også gir dokumentasjon.
        </h2>
      </div>
      <div>
        <p class="max-w-xl text-lg leading-relaxed text-[#566267]">
          Dataene dere bruker til energioptimalisering og byggeplasskontroll kan også støtte
          BREEAM-NOR-dokumentasjonen. Se hva vi tilbyr for energibruk og fuktsikkerhet, og hvilke
          fuktsensorer som kommer.
        </p>
        <p class="mt-5 text-sm font-semibold text-[#566267]">
          Energibruk – Man 03 · Fuktsikkerhet – Mat 05
        </p>
        <a
          href={site.breeam}
          class="mt-6 inline-flex min-h-11 items-center gap-4 font-semibold underline decoration-[#BFC6C3] underline-offset-4 transition-colors hover:text-[#68767A]"
        >
          Se vår BREEAM-NOR-støtte <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <Partners />

  <section class="bg-brand py-16 lg:py-24">
    <div class="zimo-shell grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
      <div>
        <p class="zimo-eyebrow text-[#584A00]">Bli kunde</p>
        <h2 class="mt-5 max-w-2xl text-4xl font-semibold leading-[1.08] tracking-[-0.04em] sm:text-5xl">
          Hvor kan dere bruke
          <br />
          energien smartere?
        </h2>
      </div>
      <div>
        <p class="max-w-md text-lg leading-relaxed text-[#443B0C]">
          Fortell oss om energibruken, utstyret og utfordringene på byggeplassen. Sammen finner vi
          et oppsett med riktig styring og en økonomi som passer prosjektet.
        </p>
        <a
          href={site.becomeCustomer}
          class="mt-7 inline-flex min-h-12 items-center justify-center gap-8 rounded-[8px] bg-[#111315] px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[#30373A]"
        >
          La oss ta en prat <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
