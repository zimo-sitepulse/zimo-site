---
import { site } from "../data/site";
const destination = site.home;
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={new URL(destination, site.url)} />
    <title>SitePulse - ZiMO</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p>
      Du blir sendt videre til <a href={destination}>SitePulse</a>.
    </p>
  </body>
</html>
