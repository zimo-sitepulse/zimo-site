---
import ArrowIcon from "../../components/ArrowIcon.astro";
import { site, contactHref, readyToUse } from "../../data/site";
import Layout from "../../layouts/Layout.astro";
import { products, productHref, type Product } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
interface Props {
  product: Product;
}
const { product } = Astro.props;
const otherProducts = products.filter((item) => item.slug !== product.slug);
---

<Layout title={`${product.title} – SitePulse fra ZiMO`} description={product.intro}>
  <section class="border-b border-[#D4D8D5] bg-[#F5F5F2] py-12 sm:py-20 lg:py-28">
    <div class="zimo-shell">
      <a
        href={site.home}
        class="text-sm text-[#566267] underline decoration-[#BFC6C3] underline-offset-4 hover:text-[#111315]"
      >
        <ArrowIcon direction="left" /> Tilbake til SitePulse
      </a>
      <div class:list={["mt-12 grid gap-12", product.image && "lg:grid-cols-2 lg:items-center"]}>
        <div class="max-w-3xl">
          <p class="zimo-eyebrow">SitePulse / Produkter</p>
          {product.comingSoon && (
            <p class="mt-5 inline-flex rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-[#111315]">
              Kommer snart
            </p>
          )}
          <h1 class="mt-5 break-words text-4xl font-semibold leading-[1.04] tracking-[-0.045em] sm:text-5xl lg:text-6xl">
            {product.title}
          </h1>
          <p class="mt-6 max-w-2xl text-xl leading-relaxed text-[#566267]">{product.intro}</p>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-[#68767A]">
            {product.description}
          </p>
          {!product.comingSoon && (
            <div class="mt-6 max-w-2xl border-l-2 border-brand pl-4">
              <p class="font-semibold">{readyToUse.title}</p>
              <p class="mt-1 text-sm leading-relaxed text-[#566267]">{readyToUse.summary}</p>
            </div>
          )}
          <a
            href={contactHref(`SitePulse – ${product.label}`)}
            class="mt-9 inline-flex min-h-11 items-center justify-center rounded-[8px] bg-brand px-6 py-3 text-sm font-semibold text-[#111315] transition-colors hover:bg-brand-hover"
          >
            {product.comingSoon ? "Meld interesse" : "Snakk med oss om produktet"}
          </a>
        </div>
        {product.image && (
          <figure>
            <img
              src={product.image.src}
              width={product.image.width}
              height={product.image.height}
              alt={product.image.alt}
              class="h-auto w-full mix-blend-multiply"
              decoding="async"
            />
            <figcaption class="mt-3 text-center text-xs text-[#68767A]">
              {product.image.caption}
            </figcaption>
          </figure>
        )}
      </div>
    </div>
  </section>
  {product.details.length > 0 && (
    <section class="bg-white py-16 lg:py-20" aria-label="Om produktet">
      <div class="zimo-shell grid gap-10 md:grid-cols-3">
        {product.details.map((detail) => (
          <article class="border-t border-[#D4D8D5] pt-6">
            <h2 class="text-xl font-semibold">{detail.title}</h2>
            <p class="mt-4 text-base leading-relaxed text-[#68767A]">{detail.text}</p>
          </article>
        ))}
      </div>
    </section>
  )}
  <section class="border-t border-[#D4D8D5] py-14">
    <div class="zimo-shell">
      <h2 class="text-xl font-semibold">Flere produkter fra SitePulse</h2>
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="Andre produkter">
        {otherProducts.map((item) => (
          <a
            href={productHref(item)}
            class="flex flex-wrap items-center justify-between gap-3 rounded-[8px] border border-[#D4D8D5] bg-white px-5 py-4 text-sm font-medium transition-colors hover:bg-[#fff8cc]"
          >
            <span>
              {item.label} <ArrowIcon direction="right" />
            </span>
            {item.comingSoon && <span class="text-xs text-[#68767A]">Kommer snart</span>}
          </a>
        ))}
      </nav>
    </div>
  </section>
</Layout>
