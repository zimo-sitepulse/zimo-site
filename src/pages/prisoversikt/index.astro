---
import Layout from "../../layouts/Layout.astro";
import { site, readyToUse } from "../../data/site";
import { products, productHref } from "../../data/products";
import { gatewaySubscription } from "../../data/pricing";
---

<Layout
  title="Prisoversikt – ZiMO"
  description="Se prisinformasjon for SitePulse og få et tilbud tilpasset byggeplassen. Produktene leveres ferdig satt opp, uten behov for WiFi."
>
  <section class="bg-[#111315] py-16 text-white lg:py-24">
    <div class="zimo-shell">
      <p class="zimo-eyebrow text-brand">SitePulse</p>
      <h1 class="mt-6 text-5xl font-semibold leading-[1.04] tracking-[-0.045em] sm:text-6xl lg:text-7xl">
        Prisoversikt
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/70">
        Et oppsett som passer byggeplassen. Vi hjelper dere å velge produkter og tilkobling ut fra
        prosjektets behov.
      </p>
    </div>
  </section>

  <section class="bg-[#F5F5F2] py-16 lg:py-24" aria-labelledby="subscription-heading">
    <div class="zimo-shell">
      <div class="grid gap-8 border-b border-[#D4D8D5] pb-12 md:grid-cols-2 md:items-center">
        <div>
          <p class="zimo-eyebrow">Abonnement</p>
          <h2
            id="subscription-heading"
            class="mt-4 text-3xl font-semibold tracking-[-0.035em] sm:text-4xl"
          >
            Tilkobling via gateway
          </h2>
          <p class="mt-4 max-w-lg leading-relaxed text-[#566267]">
            {gatewaySubscription.description} Gatewayen bruker mobilnettet, så byggeplassen trenger
            ikke WiFi.
          </p>
        </div>
        <div class="md:justify-self-end">
          <p class="text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">
            {gatewaySubscription.price}
          </p>
          <p class="mt-3 text-sm text-[#566267]">Abonnement for gatewayens tilkobling.</p>
        </div>
      </div>

      <div class="mt-12">
        <h2 class="text-2xl font-semibold tracking-[-0.025em]">Produkter</h2>
        <p class="mt-3 max-w-xl leading-relaxed text-[#566267]">
          Produktpriser og samlet oppsett får dere i et tilbud tilpasset prosjektet.
        </p>
        <ul class="mt-7 divide-y divide-[#D4D8D5] border-y border-[#D4D8D5]">
          {products.map((product) => (
            <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-5">
              <a
                href={productHref(product)}
                class="inline-flex min-h-11 items-center font-medium underline decoration-[#BFC6C3] underline-offset-4 transition-colors hover:text-[#68767A]"
              >
                {product.title}
              </a>
              <span class="text-sm text-[#566267]">
                {product.comingSoon ? "Kommer snart" : "Pris på forespørsel"}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20">
    <div class="zimo-shell grid gap-8 md:grid-cols-[1.3fr_0.7fr] md:items-center">
      <div>
        <p class="zimo-eyebrow">Klar til bruk</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.035em] sm:text-4xl">
          {readyToUse.title}
        </h2>
        <p class="mt-4 max-w-xl leading-relaxed text-[#566267]">
          {readyToUse.summary} Fortell oss om byggeplassen, så setter vi sammen et tilbud.
        </p>
      </div>
      <a
        href={site.contact}
        class="inline-flex min-h-12 items-center justify-center gap-8 justify-self-start rounded-[8px] bg-brand px-6 py-3.5 text-sm font-semibold text-[#111315] transition-colors hover:bg-brand-hover md:justify-self-end"
      >
        Kontakt oss for et tilbud <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>
