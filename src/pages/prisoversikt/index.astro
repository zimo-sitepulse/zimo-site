---
import Layout from "../../layouts/Layout.astro";
import { site, readyToUse } from "../../data/site";
import PricingCard from "../../components/PricingCard.astro";
import { buildPlans, buildTerms } from "../../data/pricing";
---

<Layout
  title="Prisoversikt – ZiMO"
  description="SitePulse Build fra 1 490 kr/mnd. Velg opptil 10, 25 eller 50 standardenheter, med SitePulse Cloud og nødvendig gateway inkludert."
>
  <section class="bg-[#111315] py-14 text-white lg:py-16">
    <div class="zimo-shell">
      <p class="zimo-eyebrow text-brand">SitePulse</p>
      <h1 class="mt-5 text-5xl font-semibold leading-[1.04] tracking-[-0.045em] sm:text-6xl lg:text-7xl">
        Prisoversikt
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/70">
        Velg pakken som passer byggeplassen. Standardenheter, SitePulse Cloud og nødvendig gateway
        er samlet i én månedspris.
      </p>
    </div>
  </section>

  <section class="bg-[#F5F5F2] py-12 lg:py-16" aria-labelledby="build-heading">
    <div class="zimo-shell">
      <p class="zimo-eyebrow">Abonnement</p>
      <h2 id="build-heading" class="mt-4 text-3xl font-semibold tracking-[-0.035em] sm:text-4xl">
        SitePulse Build
      </h2>
      <div class="mt-7 flex flex-col gap-5 border-y border-[#D4D8D5] py-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-medium text-[#566267]">Gjelder alle pakker</p>
        <dl class="grid grid-cols-2 gap-4 text-sm sm:gap-10">
          <div>
            <dt class="text-[#566267]">Minimumsperiode</dt>
            <dd class="mt-1 font-semibold">{buildTerms.minimumPeriod}</dd>
          </div>
          <div>
            <dt class="text-[#566267]">Oppstartskostnad</dt>
            <dd class="mt-1 font-semibold">{buildTerms.startupCost}</dd>
          </div>
        </dl>
      </div>
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        {buildPlans.map((plan) => (
          <PricingCard plan={plan} />
        ))}
      </div>
      <div class="mt-5 flex flex-col gap-6 rounded-[8px] bg-[#1B1F23] p-6 text-white sm:p-8 md:flex-row md:items-center md:justify-between">
        <div>
          <h3 class="text-xl font-semibold tracking-[-0.02em]">Større prosjekter og kunder</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">
            Kontakt oss for et tilbud tilpasset deres behov.
          </p>
        </div>
        <a
          href={site.contact}
          class="inline-flex min-h-12 shrink-0 cursor-pointer items-center justify-between gap-8 rounded-[8px] bg-brand px-5 py-3 text-sm font-semibold text-[#111315] transition-colors duration-200 hover:bg-brand-hover"
        >
          Kontakt oss for tilbud
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20">
    <div class="zimo-shell grid gap-8 md:grid-cols-[1.3fr_0.7fr] md:items-center">
      <div>
        <p class="zimo-eyebrow">Klar til bruk</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.035em] sm:text-4xl">
          {readyToUse.title}
        </h2>
        <p class="mt-4 max-w-xl leading-relaxed text-[#566267]">
          {readyToUse.summary} Fortell oss om byggeplassen, så setter vi sammen et tilbud.
        </p>
      </div>
      <a
        href={site.contact}
        class="inline-flex min-h-12 items-center justify-center gap-8 justify-self-start rounded-[8px] bg-brand px-6 py-3.5 text-sm font-semibold text-[#111315] transition-colors hover:bg-brand-hover md:justify-self-end"
      >
        Kontakt oss for et tilbud <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>
