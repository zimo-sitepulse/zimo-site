---
import Layout from "../../layouts/Layout.astro";
import { site, readyToUse } from "../../data/site";
import { buildPlans, buildIncludes } from "../../data/pricing";
---

<Layout
  title="Prisoversikt – ZiMO"
  description="SitePulse Build fra 1 490 kr/mnd. Velg opptil 10, 25 eller 50 standardenheter, med SitePulse Cloud og nødvendig gateway inkludert."
>
  <section class="bg-[#111315] py-16 text-white lg:py-24">
    <div class="zimo-shell">
      <p class="zimo-eyebrow text-brand">SitePulse</p>
      <h1 class="mt-6 text-5xl font-semibold leading-[1.04] tracking-[-0.045em] sm:text-6xl lg:text-7xl">
        Prisoversikt
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/70">
        Velg pakken som passer byggeplassen. Standardenheter, SitePulse Cloud og nødvendig gateway
        er samlet i én månedspris.
      </p>
    </div>
  </section>

  <section class="bg-[#F5F5F2] py-16 lg:py-24" aria-labelledby="build-heading">
    <div class="zimo-shell">
      <p class="zimo-eyebrow">Abonnement</p>
      <h2 id="build-heading" class="mt-4 text-3xl font-semibold tracking-[-0.035em] sm:text-4xl">
        SitePulse Build
      </h2>
      <div class="mt-9 grid gap-5 lg:grid-cols-3">
        {buildPlans.map((plan) => (
          <article class="flex flex-col rounded-[8px] border border-[#D4D8D5] bg-white p-7 sm:p-8">
            <h3 class="text-xl font-semibold">{plan.name}</h3>
            <p class="mt-6 flex flex-wrap items-baseline gap-x-2">
              <span class="text-4xl font-semibold tracking-[-0.04em]">{plan.price}</span>
              <span class="text-sm text-[#566267]">kr/mnd</span>
            </p>
            <ul class="mb-8 mt-7 space-y-4 border-t border-[#D4D8D5] pt-6 text-[#566267]">
              {[`Opptil ${plan.units} standardenheter`, ...buildIncludes].map((feature) => (
                <li class="flex items-start gap-3">
                  <span class="font-semibold text-[#8B7500]" aria-hidden="true">
                    ✓
                  </span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <a
              href={site.contact}
              aria-label={`Kontakt oss om ${plan.name}`}
              class="mt-auto inline-flex min-h-12 items-center justify-center gap-8 rounded-[8px] bg-brand px-5 py-3 text-sm font-semibold text-[#111315] transition-colors hover:bg-brand-hover"
            >
              Kontakt oss <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20">
    <div class="zimo-shell grid gap-8 md:grid-cols-[1.3fr_0.7fr] md:items-center">
      <div>
        <p class="zimo-eyebrow">Klar til bruk</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.035em] sm:text-4xl">
          {readyToUse.title}
        </h2>
        <p class="mt-4 max-w-xl leading-relaxed text-[#566267]">
          {readyToUse.summary} Fortell oss om byggeplassen, så setter vi sammen et tilbud.
        </p>
      </div>
      <a
        href={site.contact}
        class="inline-flex min-h-12 items-center justify-center gap-8 justify-self-start rounded-[8px] bg-brand px-6 py-3.5 text-sm font-semibold text-[#111315] transition-colors hover:bg-brand-hover md:justify-self-end"
      >
        Kontakt oss for et tilbud <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>
